# Google Gemini (default provider)
GEMINI_API_KEY=

# fal.ai — https://fal.ai/dashboard/keys
FAL_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Output directory for generated images. When unset, output lands in ./output
# relative to the current working directory. Set an absolute path to pin it.
# LIMNER_OUTPUT_DIR=/absolute/path/to/output